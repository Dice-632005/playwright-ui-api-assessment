{
  "name": "playwright-ui-api-assessment",
  "version": "1.0.0",
  "description": "Senior-level Playwright automation framework assessing UI and API testing with Page Object Model and clean architecture.",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:api": "playwright test tests/api/restful-booker.spec.js --workers=1 --project=api",
    "report:html": "playwright show-report",
    "report:allure:generate": "allure generate allure-results --clean --single-file -o allure-report",
    "report:allure:open": "allure open allure-report",
    "report:monocart": "monocart show-report monocart-report/sauceDemoMonocartReport.html"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dice-632005/playwright-ui-api-assessment.git"
  },
  "keywords": [
    "playwright",
    "test-automation",
    "api-testing",
    "ui-testing",
    "pom"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Dice-632005/playwright-ui-api-assessment/issues"
  },
  "homepage": "https://github.com/Dice-632005/playwright-ui-api-assessment#readme",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.0",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "dotenv": "^17.4.2",
    "monocart-reporter": "^2.12.2"
  }
}
